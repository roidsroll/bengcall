{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tailwindcss -i resources/css/app.css -o public/css/app.css --minify && node scripts/copy-fontawesome-webfonts.mjs",
        "dev": "node scripts/copy-fontawesome-webfonts.mjs && tailwindcss -i resources/css/app.css -o public/css/app.css --watch"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.2",
        "autoprefixer": "^10.4.27",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "postcss": "^8.5.8",
        "tailwindcss": "^4.2.2"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0"
    }
}
